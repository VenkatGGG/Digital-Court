# Lex Umbra - Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Google AI Studio API Key (Required)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model Configuration
# GEMINI_MODEL=gemini-2.5-flash

# Voice Courtroom Configuration (Optional)
# These are the endpoints for the NVIDIA PersonaPlex GPU nodes
# VOICE_SERVER_HOST=localhost
# VOICE_SERVER_PORT=8765
# DEFENSE_API_URL=http://localhost:8001/generate
# PROSECUTOR_API_URL=http://localhost:8002/generate
